# ==================== 服务器配置 ====================
PORT=3100
ENABLE_WEB_API=true

# ==================== 交易参数 ====================
TRADING_INTERVAL_MINUTES=5      # 交易循环间隔（分钟）
MAX_LEVERAGE=10                 # 最大杠杆倍数
MAX_POSITIONS=5                 # 最大持仓数量
MAX_HOLDING_HOURS=36            # 最大持有时长（小时）
INITIAL_BALANCE=2000            # 初始资金（USDT）

# 交易策略选择
# 可选值：conservative, balanced, aggressive, ultra-short, swing-trend
TRADING_STRATEGY=balanced

# 交易币种（逗号分隔）
TRADING_SYMBOLS=BTC,ETH,SOL,XRP,BNB,BCH

# ==================== 数据库配置 ====================
DATABASE_URL=file:./.voltagent/trading.db

# ==================== Gate.io API 凭证 ====================
# ⚠️ 建议先使用测试网！
GATE_API_KEY=your_api_key_here
GATE_API_SECRET=your_api_secret_here
GATE_USE_TESTNET=true

# 获取API密钥：
# 测试网：https://www.gate.io/testnet
# 正式网：https://www.gatesite.org/signup/VVVEA10LVQ?ref_type=103

# ==================== AI 模型提供商 ====================
# OpenAI 兼容 API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_NAME=deepseek/deepseek-v3.2-exp

# 支持的API提供商：
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com/v1

# 推荐模型：
# - deepseek/deepseek-v3.2-exp  (高性价比)
# - x-ai/grok-4-fast            (快速响应)
# - openai/gpt-4o               (高质量)
# - anthropic/claude-4.5-sonnet (强分析能力)

# ==================== 账户风控配置 ====================
# 账户止损线和止盈线（触发后清仓并退出系统）
ACCOUNT_STOP_LOSS_USDT=50       # 账户余额低于此值时强制清仓
ACCOUNT_TAKE_PROFIT_USDT=10000  # 账户余额高于此值时获利了结

# 账户回撤保护（从峰值回撤百分比）
ACCOUNT_DRAWDOWN_WARNING_PERCENT=20          # 警告阈值：发出风险提醒
ACCOUNT_DRAWDOWN_NO_NEW_POSITION_PERCENT=30  # 禁止开仓阈值：停止新仓位
ACCOUNT_DRAWDOWN_FORCE_CLOSE_PERCENT=50      # 强制平仓阈值：清仓保护资金

# 单笔亏损极限（防止爆仓的最后防线）
EXTREME_STOP_LOSS_PERCENT=-30   # 单笔亏损达到此值强制平仓

# ==================== 监控和日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=./logs/trading.log

# 是否启用文件日志
LOG_TO_FILE=true

# ==================== 高级配置 ====================
# 账户记录间隔（分钟）
ACCOUNT_RECORD_INTERVAL_MINUTES=10

# 监控器检查间隔（秒）
MONITOR_CHECK_INTERVAL_SECONDS=10

# 是否在启动时同步配置到数据库
SYNC_CONFIG_ON_STARTUP=true

# ==================== 开发/调试配置 ====================
# 开发模式（启用详细日志和热重载）
DEV_MODE=false

# 是否启用测试模式（模拟交易，不真实下单）
DRY_RUN=false

# API请求超时（秒）
API_TIMEOUT=30

# 数据库连接池大小
DB_POOL_SIZE=5

# ==================== 注意事项 ====================
# 1. 复制此文件为 .env：
#    cp .env.example .env
#
# 2. 填写真实的API密钥
#
# 3. ⚠️ 不要提交 .env 文件到Git仓库
#
# 4. 测试网和正式网可以用同一个Gate.io账户，但API密钥不同
#
# 5. 建议在测试网充分测试后再切换到正式网

